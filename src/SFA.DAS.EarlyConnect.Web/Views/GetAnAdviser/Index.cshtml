@using SFA.DAS.EarlyConnect.Web.Infrastructure
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.Vpv = "/page-default";
    ViewBag.Title = "Sorry, this service has closed";
}

<main role="main" id="content" class="govuk-main-wrapper">
    <span id="Top"></span>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="gem-c-heading govuk-!-margin-bottom-8">
                <h1 class="gem-c-heading__text govuk-heading-xl">
                    Sorry, this service has closed
                </h1>
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="article-container group govuk-grid-column-two-thirds">
            <div class="govuk-inset-text">
                <p class="govuk-body">
                    The Get an apprenticeship adviser service closed on 31 October 2025. If you're a student in Greater London, Lancashire, or the North East of England, there is still support available.
                </p>
                <p class="govuk-body">
                    The Department for Education is not responsible for content on external sites.
                </p>
            </div>

            <h2 class="govuk-heading-m">Greater London</h2>
            <p class="govuk-body">
                The Mayor of London's website has:
            </p>
            <ul class="govuk-list govuk-list--bullet">
                <li>
                    <a href="https://www.london.gov.uk/programmes-strategies/jobs-and-skills/apprenticeships-information-londoners" class="govuk-link">
                        apprenticeship information for Londoners
                    </a>
                </li>
                <li>
                    details on how to access
                    <a href="https://www.london.gov.uk/programmes-strategies/business-and-economy/mayors-priorities-londons-economy-and-business/uk-shared-prosperity-fund-ukspf/uk-shared-prosperity-fund-support-young-londoners" class="govuk-link">
                        projects for Londoners aged 16 to 24 who are not in education, employment or training
                    </a>
                </li>
            </ul>

            <h2 class="govuk-heading-m">Lancashire</h2>
            <p class="govuk-body">
                <a href="https://www.lancashireskillshub.co.uk/apprenticeship-advice/" class="govuk-link">
                    The Lancashire Skills and Employment hub
                </a>
                has information and resources about apprenticeships.
            </p>

            <h2 class="govuk-heading-m">North East</h2>
            <p class="govuk-body">
                <a href="https://ambition.northeast-ca.gov.uk/education/further-education/apprenticeready" class="govuk-link">
                    North East Ambition's apprenticeReady service
                </a>
                has help and support for students who want to know more about apprenticeships, and details of local organisations who can help you.
            </p>
            <p class="govuk-body">
                Email
                <a href="mailto:NEambition@edt.org" class="govuk-link">
                    NEambition@edt.org
                </a>
                for help finding vacancies.
            </p>
        </div>

        <div class="govuk-grid-column-one-third">
            <div class="gem-c-contextual-sidebar govuk-!-display-none-print">
                <div data-module="ga4-link-tracker" class="gem-c-related-navigation govuk-!-display-none-print">
                    <h2 id="related-nav-related_items" class="govuk-heading-m">
                        Other resources
                    </h2>

                    <nav class="gem-c-related-navigation__nav-section" aria-labelledby="related-nav-related_items">
                        <p class="govuk-body">
                            You can search and apply for apprenticeships in England on
                            <a href="https://www.gov.uk/apply-apprenticeship" class="govuk-link">
                                Find an apprenticeship
                            </a>
                        </p>
                        <p class="govuk-body">
                            Find out more about
                            <a href="https://www.gov.uk/become-apprentice" class="govuk-link">
                                how apprenticeships work
                            </a>
                        </p>
                        <p class="govuk-body">
                            You can find job opportunities and speak to an adviser at the
                            <a href="https://nationalcareers.service.gov.uk/" class="govuk-link">
                                National Careers Service
                            </a>
                        </p>
                        <p class="govuk-body">
                            <a href="http://apprenticeships.gov.uk/" class="govuk-link">
                                Apprenticeships.gov.uk
                            </a>
                            has information on finding, applying for and doing an apprenticeship.
                        </p>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</main>